__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
build/
dist/
*.egg-info/
.venv/

# 随包二进制：7-Zip 的许可证允许分发，但仓库里通过脚本下载更轻量
tools/*/7z/*
# RAR 为专有软件：不随仓库分发
tools/*/rar/

# 开发期截图与构建中间产物
build/shots/
dev/__pycache__/

# 内部工作材料（审查报告、规划文档等，不入公开仓库）
_pm/

# ⚠️ 凭据：**绝对不能进仓库**（本仓库是公开的）
# 打包/发版需要的 GitHub token 就放在项目根，靠这几条规则挡住。
.gh-token
gh-tok.txt
gh-token.txt
*.token
.env
.env.*
